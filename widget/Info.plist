<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- No ATS exception keys: loopback HTTP is exempt by default, and the
       only two URLs this process reaches are 127.0.0.1 (Bridge.swift).
       One TCC key, deliberately: the ear page captures the microphone while
       armed (VOICE-PLAN rev 3). Audio never leaves the process — STT runs
       in-page on local models. -->
  <!-- Every one of these is MANDATORY, not descriptive: requesting the
       permission without its usage string terminates the app immediately. They
       are also the sentence a person reads in the system prompt, so each says
       what is read and where it goes rather than restating the API name. -->
  <key>NSContactsUsageDescription</key>
  <string>intaglio labs reads your contacts so it knows who the people in your messages are. Everything stays on this Mac.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>intaglio labs reads your calendar so it can answer questions about your time. Everything stays on this Mac.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>intaglio labs reads your calendar so it can answer questions about your time. Everything stays on this Mac.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>intaglio labs reads your photo library so it can answer questions about where you were and who you were with. Everything stays on this Mac.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>intaglio labs listens only while the orb is armed; speech is transcribed on this Mac and never leaves it.</string>
  <key>CFBundleName</key>              <string>intaglio labs</string>
  <key>CFBundleDisplayName</key>       <string>intaglio labs</string>
  <key>CFBundleIdentifier</key>        <string>io.intaglio.widget</string>
  <key>CFBundleExecutable</key>        <string>Intaglio Labs</string>
  <key>CFBundlePackageType</key>       <string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key>           <string>1</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleIconFile</key>            <string>Intaglio Labs</string>
  <key>LSMinimumSystemVersion</key>    <string>13.0</string>
  <!-- Accessory app: no Dock icon, no menu bar. The activation policy is
       also set in code; LSUIElement covers the launch itself. -->
  <key>LSUIElement</key>               <true/>
  <key>NSHighResolutionCapable</key>   <true/>
  <key>NSPrincipalClass</key>          <string>NSApplication</string>
</dict>
</plist>
