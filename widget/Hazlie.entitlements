<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- One entitlement, for the one thing this app captures. Required once the
       hardened runtime is on: under runtime protection the microphone is
       refused outright without it, TCC prompt or no TCC prompt.

       Nothing else is requested. No network client entitlement (the app is not
       sandboxed, and its only sockets are loopback), no file access, no
       camera. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- THE TWO THE PROVISIONING PROFILE ASSERTS, and no more.
       A signed app's entitlements must be a SUBSET of the embedded profile's,
       so these mirror it exactly: anything extra makes codesign refuse, and
       anything missing makes the profile pointless.

       They exist because a development-signed Mac app with no profile is not
       validly signed FOR A MACHINE — Gatekeeper rejects it, and macOS then
       declines to show it a privacy prompt at all, recording a denial instead.
       That is what stopped the Contacts, Calendar and Photos prompts from ever
       appearing: not the code asking for them, but the app having no standing
       to ask. -->
  <key>com.apple.application-identifier</key>
  <string>5K43Q6FF67.com.hazlie.widget</string>
  <key>com.apple.developer.team-identifier</key>
  <string>5K43Q6FF67</string>
</dict>
</plist>
