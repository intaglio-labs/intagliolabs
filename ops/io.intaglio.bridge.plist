<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One mautrix bridge: a linked session on a chat platform, relaying the owner's
  DMs into the local homeserver. Installed once PER PLATFORM, so this file is
  rendered seven times with different @LABEL@/@BINARY@/@CONFIG@ values.

  A TEMPLATE: launchd expands no variables. ops/setup-bridges-native.sh
  substitutes @LABEL@, @BINARY@, @CONFIG@, @REGISTRATION@ and @LOG@ when it
  installs the rendered copy into ~/Library/LaunchAgents/. Do not bootstrap
  this file directly.

  ORDERING: launchd has none, so on a reboot a bridge can start before the
  homeserver is listening. That is fine and is not worked around -- a mautrix
  bridge retries its appservice connection rather than exiting, so it connects
  when Synapse comes up. What it is NOT fine for is a bridge that exits on a
  bad config; ThrottleInterval below is what keeps that from becoming a hot
  loop.

  Telegram is the one platform that can sit here failing for a reason no
  restart fixes: it needs an api_id/api_hash the owner has to create at
  my.telegram.org. The setup script says so at install time rather than
  leaving it looping quietly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <!-- Same identifier as every other hazlie agent ON PURPOSE: one Login Items
       entry for the app, not eight for processes nobody recognises. -->
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>io.intaglio.widget</string>
  </array>

  <key>ProgramArguments</key>
  <array>
    <string>@BINARY@</string>
    <string>-c</string>
    <string>@CONFIG@</string>
    <string>-r</string>
    <string>@REGISTRATION@</string>
    <string>-n</string>
  </array>

  <!-- WITHOUT THIS THE BRIDGE DIES AT STARTUP. mautrix's generated config has a
       file-logger writer with a RELATIVE path ("logs/..."), and launchd gives a
       job no working directory -- so CWD is / and the bridge exits with
       "can't make directories for new logfile: mkdir logs: read-only file
       system". Under nohup it inherited the setup script's CWD and happened to
       land in the repo, which is both writable and the wrong place. Its own
       state directory is where a relative path was always meant to resolve.
       Measured 2026-08-30: all seven bridges failed this way on the first
       launchd run, and the liveness gate caught it. -->
  <key>WorkingDirectory</key>
  <string>@WORKDIR@</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- 0077: a bridge's working directory holds its session cookie for the
       platform and a sqlite database of message content. -->
  <key>Umask</key>
  <integer>63</integer>

  <key>StandardOutPath</key>
  <string>@LOG@</string>

  <key>StandardErrorPath</key>
  <string>@LOG@</string>

  <!-- KeepAlive restarts on any exit; without this a bridge that cannot start
       burns CPU and fills its log while `launchctl list` calls it running.
       60 seconds is the floor launchd enforces. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
