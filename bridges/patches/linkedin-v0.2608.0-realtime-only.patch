+const (
+	maxLinkedInMessagePageSize     = 50
+	minLinkedInMessageFetchSpacing = 500 * time.Millisecond
+)
+
+func linkedInMessagePageSize(requested int) int {
+	if requested < 1 || requested > maxLinkedInMessagePageSize {
+		return maxLinkedInMessagePageSize
+	}
+	return requested
+}
+
+func (l *LinkedInClient) beginLinkedInMessageFetch(ctx context.Context) (func(), error) {
+	l.messageFetchMu.Lock()
+	remaining := minLinkedInMessageFetchSpacing - time.Since(l.lastMessageFetch)
+	if remaining > 0 {
+		timer := time.NewTimer(remaining)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			l.messageFetchMu.Unlock()
+			return nil, ctx.Err()
+		case <-timer.C:
+		}
+	}
+	return func() {
+		l.lastMessageFetch = time.Now()
+		l.messageFetchMu.Unlock()
+	}, nil
+}
+
