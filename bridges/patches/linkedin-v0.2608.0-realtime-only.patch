--- /dev/null
+++ b/pkg/connector/realtime_test.go
@@ -0,0 +1,20 @@
+package connector
+
+import "testing"
+
+func TestConversationSyncStopsAfterOnePage(t *testing.T) {
+	if !shouldFetchLinkedInConversationPage(0) {
+		t.Fatal("the first recent-conversation page must be fetched")
+	}
+	if shouldFetchLinkedInConversationPage(1) {
+		t.Fatal("a second conversation page would turn live sync into history crawling")
+	}
+}
+
+func TestLinkedInMessagePageSizeIsBounded(t *testing.T) {
+	for _, requested := range []int{-1, 0, 2_147_483_647} {
+		if got := linkedInMessagePageSize(requested); got != 50 {
+			t.Fatalf("unsafe request %d became page size %d, want 50", requested, got)
+		}
+	}
+}
