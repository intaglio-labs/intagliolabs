{
  "hosting": [
    {
      "target": "intaglio",
      "public": "site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/DEPLOY.md"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "redirects": [
        {
          "source": "/Hazlie.dmg",
          "destination": "/intagliolabs.dmg",
          "type": 301
        }
      ]
    }
  ]
}