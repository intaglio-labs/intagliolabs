# Dependencies
node_modules/

# Build output
widget/build/
widget/voice/public/
widget/voice/node_modules/
dist/

# Runtime state and secrets never belong in the repo. Everything this system
# stores lives under ~/.hazlie (0700), outside any checkout, by design.
.env
.env.*
!.env.example
*.log
.hazlie/
secrets/
credentials*.json
# Google OAuth clients. This repository is PUBLIC: a client id committed here is
# a Google project handed to whoever clones it.
#
# widget/build.sh does not write into the checkout -- it stages the build
# machine's clients straight into $BE, which is either /private/tmp or
# widget/build/, both already ignored above. ops/google-clients/ is the READ
# path bundledClientsDir() resolves to in a dev checkout, so the entry below
# covers a developer who puts real clients there by hand to exercise the
# bundled-client path. google-client-*.json is unanchored and so matches at any
# depth, which is the rule that actually protects a credential dropped anywhere
# in the tree; an explicit `git add` of an ignored path still errors without -f.
ops/google-clients/
google-client-*.json
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite3-journal
*.db-journal
*.db-wal
*.db-shm
*.people-search-cache*
*.people-summaries*
*.tallies*
*.dmg

# macOS
.DS_Store

# Firebase Hosting deploy cache — local, regenerated on every deploy.
.firebase/
