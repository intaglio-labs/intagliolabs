# Dependencies
node_modules/

# Build output
widget/build/
widget/voice/public/
widget/voice/node_modules/
dist/

# Runtime state and secrets never belong in the repo. Everything this system
# stores lives under ~/.hazlie (0700), outside any checkout, by design.
.env
.env.*
!.env.example
*.log
.hazlie/
secrets/
credentials*.json
# Google OAuth clients staged into the app bundle by widget/build.sh, and the
# checkout-side directory it reads them into. This repository is PUBLIC: a
# client id committed here is a Google project handed to whoever clones it.
ops/google-clients/
google-client-*.json
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite3-journal
*.db-journal
*.db-wal
*.db-shm
*.people-search-cache*
*.people-summaries*
*.tallies*
*.dmg

